#!/usr/bin/env bash
# Usage: countdown-engine {start|add|pause|resume|toggle|reset|status|inhibit|inhibit-state|...|daemon}
# Old names: `study` -> `pomodoro` -> back to `countdown` (matches key $mod+c).

STATE_DIR="${XDG_RUNTIME_DIR:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/countdown-state"
LOCK_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/countdown-state.lock"
FLOCK="flock"
JQ="jq"
SLEEP_MARKER="$STATE_DIR/countdown-sleep-paused"
MANUAL_FLAG="$STATE_DIR/inhibit-manual"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/countdown-history.log"
LEGACY_HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/pomodoro-history.log"
mkdir -p "$STATE_DIR" "$(dirname "$LOCK_FILE")" "$(dirname "$HISTORY_FILE")"
exec 9>>"$LOCK_FILE"

# Serialize state transitions shared by Waybar, the menu and the timer daemon.
state_lock() {
  "$FLOCK" -x 9 || {
    echo "countdown-engine: cannot acquire state lock" >&2
    exit 1
  }
}

state_unlock() {
  "$FLOCK" -u 9 || {
    echo "countdown-engine: cannot release state lock" >&2
    exit 1
  }
}

# Migrate legacy files only when needed, under the state lock. This
# keeps concurrent Waybar/menu invocations from choosing or appending
# migration files at the same time, without locking routine status polls.
if [ -f "$STATE_DIR/pomodoro-state" ] ||
   [ -f "$STATE_DIR/study-state" ] ||
   [ -f "$STATE_DIR/pomodoro-sleep-paused" ] ||
   [ -f "$LEGACY_HISTORY_FILE" ]; then
  state_lock

  if [ -f "$STATE_DIR/pomodoro-state" ] || [ -f "$STATE_DIR/study-state" ]; then
    # GNU stat's %y includes sub-second precision. The fixed timestamp
    # format sorts lexically; exact ties keep the canonical file first.
    newest_state=""
    newest_mtime=""
    for f in "$STATE_FILE" "$STATE_DIR/pomodoro-state" "$STATE_DIR/study-state"; do
      [ -f "$f" ] || continue
      mt=$(stat -c %y "$f" 2>/dev/null) || continue
      if [ -z "$newest_mtime" ] || [[ "$mt" > "$newest_mtime" ]]; then
        newest_mtime=$mt
        newest_state=$f
      fi
    done

    if [ "$newest_state" = "$STATE_FILE" ]; then
      rm -f -- "$STATE_DIR/pomodoro-state" "$STATE_DIR/study-state"
    elif [ -n "$newest_state" ] && mv -f -- "$newest_state" "$STATE_FILE"; then
      rm -f -- "$STATE_DIR/pomodoro-state" "$STATE_DIR/study-state"
    else
      echo "countdown-engine: state migration failed; keeping legacy state files" >&2
    fi
  fi

  if [ -f "$STATE_DIR/pomodoro-sleep-paused" ]; then
    if [ ! -e "$SLEEP_MARKER" ]; then
      mv -f -- "$STATE_DIR/pomodoro-sleep-paused" "$SLEEP_MARKER" ||
        echo "countdown-engine: could not migrate sleep marker" >&2
    else
      rm -f -- "$STATE_DIR/pomodoro-sleep-paused"
    fi
  fi

  if [ -f "$LEGACY_HISTORY_FILE" ]; then
    if [ -f "$HISTORY_FILE" ]; then
      if cat "$LEGACY_HISTORY_FILE" >> "$HISTORY_FILE"; then
        rm -f -- "$LEGACY_HISTORY_FILE"
      fi
    else
      mv -f -- "$LEGACY_HISTORY_FILE" "$HISTORY_FILE"
    fi
  fi

  state_unlock
fi

read_state() {
  TASK=""
  INITIAL_DURATION=""
  if [ -f "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    # Older state files have no immutable starting estimate.
    INITIAL_DURATION="${INITIAL_DURATION:-$DURATION}"
  else
    DURATION=""
    INITIAL_DURATION=""
    RUNNING="false"
    END_TIME=""
    REMAINING=""
    TASK=""
  fi
}

idle_inhibited() {
  local current_time
  current_time=$(date +%s)
  { [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ] && [ "$END_TIME" -gt "$current_time" ]; } ||
    [ -f "$MANUAL_FLAG" ]
}

# Own only our inhibitor. Logind and the session manager decide how to honor it.
# Never wait on a unit while holding the state lock: its startup may need us.
sync_idle_inhibit() {
  local action=stop
  if idle_inhibited; then
    action=start
  fi
  systemctl --user --no-block "$action" countdown-idle-inhibit.service ||
    echo "countdown-engine: failed to $action idle inhibitor; worker will retry" >&2
}

write_state() {
  local tmp
  # Same-directory rename keeps readers from seeing a partially written state.
  tmp=$(mktemp "$STATE_FILE.XXXXXX") || return 1
  if ! {
    printf 'DURATION="%s"\nINITIAL_DURATION="%s"\nRUNNING="%s"\nEND_TIME="%s"\nREMAINING="%s"\n' \
      "$DURATION" "$INITIAL_DURATION" "$RUNNING" "$END_TIME" "$REMAINING"
    printf 'TASK=%q\n' "$TASK"
  } > "$tmp"; then
    rm -f -- "$tmp"
    return 1
  fi
  if ! mv -f -- "$tmp" "$STATE_FILE"; then
    rm -f -- "$tmp"
    return 1
  fi
  sync_idle_inhibit
}

get_remaining() {
  if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ]; then
    now=$(date +%s)
    remaining=$((END_TIME - now))
    [ "$remaining" -lt 0 ] && remaining=0
  elif [ -n "$REMAINING" ]; then
    remaining="$REMAINING"
  else
    remaining=0
  fi
  echo "$remaining"
}

# Seconds studied (clamped to [0, DURATION*60]).
get_elapsed() {
  if [ -z "$DURATION" ]; then
    echo 0
  elif [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ]; then
    e=$((DURATION * 60 - (END_TIME - $(date +%s))))
    [ "$e" -gt $((DURATION * 60)) ] && e=$((DURATION * 60))
    [ "$e" -lt 0 ] && e=0
    echo "$e"
  elif [ -n "$REMAINING" ]; then
    e=$((DURATION * 60 - REMAINING))
    [ "$e" -lt 0 ] && e=0
    echo "$e"
  else
    echo $((DURATION * 60))
  fi
}

format_time() {
  local secs=$1
  printf "%02d:%02d" $((secs / 60)) $((secs % 60))
}

play_sound() {
  # Use a dedicated stream at unity gain: follow the speaker volume rather than
  # inheriting a quiet volume saved for unrelated paplay invocations.
  timeout 15s paplay --client-name=countdown --stream-name="Countdown alarm" --volume=65536 \
    "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga" ||
    echo "countdown-engine: failed to play the completion alarm" >&2
}

log_history() {
  # $1 = session label, $2 = number of minutes
  printf '%s | %s | %s min\n' "$(date '+%Y-%m-%d %H:%M')" "$1" "$2" >> "$HISTORY_FILE"
}

# Log history if the session is replaced/reset after >= 1 minute studied.
maybe_log_current() {
  elapsed=$(get_elapsed)
  if [ "$elapsed" -ge 60 ]; then
    log_history "$1 (interrupted)" "$((elapsed / 60))"
  fi
}

notify_waybar() {
  # Signal 8 = countdown time, 10 = play/pause control, 7 = idle inhibition.
  # Skip Waybar until its handler is installed: an early RT signal terminates it.
  pkill --require-handler --exact --euid "$UID" -RTMIN+8 waybar 2>/dev/null || true
  pkill --require-handler --exact --euid "$UID" -RTMIN+10 waybar 2>/dev/null || true
  pkill --require-handler --exact --euid "$UID" -RTMIN+7 waybar 2>/dev/null || true
}

notify_clock() {
  # Refresh only the countdown time every second.
  pkill --require-handler --exact --euid "$UID" -RTMIN+8 waybar 2>/dev/null || true
}

stop_state_watcher() {
  kill "$COUNTDOWN_WATCH_PID" 2>/dev/null || true
  wait "$COUNTDOWN_WATCH_PID" 2>/dev/null || true
}

daemon_loop() {
  local events event status next_sync=0 dirty=1
  local -a read_timeout

  # Watch the directory because write_state replaces the state file atomically.
  # Subscribe BEFORE taking the first snapshot so start/resume cannot be lost
  # between reading an idle state and going to sleep. The watcher must not
  # inherit the state lock, which could otherwise block every command forever.
  exec {events}< <(
    export LC_ALL=C
    exec inotifywait --monitor --event moved_to,moved_from,close_write,delete \
      --include '/(countdown-state|inhibit-manual)$' --format change "$STATE_DIR" 9>&- 2>&1
  )
  COUNTDOWN_WATCH_PID=$!
  trap stop_state_watcher EXIT
  while IFS= read -r -u "$events" event; do
    [ "$event" = 'Watches established.' ] && break
    [ "$event" = 'Setting up watches.' ] || echo "countdown-engine: $event" >&2
  done
  [ "$event" = 'Watches established.' ] || return 1

  while true; do
    read_state
    # Reconcile on changes/startup and every five seconds while there is an
    # active timer or manual inhibitor to protect. Idle needs no periodic work.
    if [ "$dirty" -eq 1 ] || [ "$SECONDS" -ge "$next_sync" ]; then
      state_lock
      read_state
      sync_idle_inhibit
      state_unlock
      next_sync=$((SECONDS + 5))
    fi
    if session_expired; then
      state_lock
      read_state
      finished_duration=""
      finalize_if_expired || {
        state_unlock
        exit 1
      }
      state_unlock
      notify_finished
    fi
    if [ "$dirty" -eq 1 ]; then
      notify_waybar
    elif [ "$RUNNING" = "true" ]; then
      notify_clock
    fi
    dirty=0

    # read blocks in the kernel: no sleep subprocess and no polling at all
    # while paused/empty, unless manual keep-awake needs health reconciliation.
    read_timeout=()
    if [ "$RUNNING" = "true" ]; then
      read_timeout=(-t 1)
    elif [ -f "$MANUAL_FLAG" ]; then
      read_timeout=(-t 5)
    fi
    if IFS= read -r -u "$events" "${read_timeout[@]}" event; then
      [ "$event" = change ] || { echo "countdown-engine: $event" >&2; return 1; }
      dirty=1
    else
      status=$?
      # A timeout is expected while running. EOF means the watcher failed;
      # fail the worker too so systemd restarts both and restores the watch.
      [ "$status" -gt 128 ] || { echo "countdown-engine: state watcher stopped" >&2; return 1; }
    fi
  done
}

# systemd owns the worker; starting an active unit neither duplicates nor kills it.
ensure_daemon() {
  systemctl --user --no-block start countdown-engine.service
}

# Clear the "sleep auto-pause" marker when the user acts manually.
clear_sleep_marker() {
  rm -f "$SLEEP_MARKER" 2>/dev/null || true
}

session_expired() {
  [ -n "$DURATION" ] || return 1
  if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ]; then
    now=$(date +%s)
    [ "$END_TIME" -le "$now" ]
  else
    # Recover zero-second paused sessions written by older versions too.
    [ "$REMAINING" = "0" ]
  fi
}

# Must be called under state_lock; only one caller can finalize and log a session.
finalize_if_expired() {
  session_expired || return 0
  finished_duration="$DURATION"
  DURATION=""
  INITIAL_DURATION=""
  RUNNING="false"
  END_TIME=""
  REMAINING=""
  TASK=""
  write_state || return 1
  clear_sleep_marker
  log_history "countdown" "$finished_duration"
}

notify_finished() {
  [ -n "$finished_duration" ] || return 0
  notify_waybar
  # Audio must not delay the popup or the worker's next tick. The child must not
  # inherit the state-lock descriptor, including after its parent exits.
  play_sound 9>&- &
  notify-send -a countdown -c countdown.finished -i "chronometer" -t 10000 -u critical \
    "Focus" "Focus session finished! $finished_duration min 🍅"
}

pause_current() {
  finalize_if_expired || return 1
  if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ]; then
    # session_expired captured now while holding this same state lock.
    REMAINING=$((END_TIME - now))
    RUNNING="false"
    END_TIME=""
    write_state || return 1
    changed=1
  fi
}

resume_current() {
  finalize_if_expired || return 1
  if [ "$RUNNING" != "true" ] && [ -n "$REMAINING" ] && [ "$REMAINING" -gt 0 ]; then
    now=$(date +%s)
    END_TIME=$((now + REMAINING))
    RUNNING="true"
    write_state || return 1
    ensure_daemon || return 1
    changed=1
  fi
}

case "${1:-status}" in
  start)
    minutes="${2:-}"
    # Integer 1-480 (validated by the countdown menu).
    if ! [[ "$minutes" =~ ^[1-9][0-9]*$ ]] || [ "$minutes" -lt 1 ] || [ "$minutes" -gt 480 ]; then
      echo "Usage: countdown-engine start <1-480>" >&2
      exit 1
    fi
    state_lock
    read_state
    finished_duration=""
    finalize_if_expired || exit 1
    maybe_log_current "countdown"
    clear_sleep_marker
    now=$(date +%s)
    DURATION="$minutes"
    INITIAL_DURATION="$minutes"
    TASK="${3:-}"
    RUNNING="true"
    END_TIME=$((now + minutes * 60))
    REMAINING=""
    write_state || exit 1
    ensure_daemon
    state_unlock
    notify_finished
    notify_waybar
    notify-send -a countdown -i "chronometer" -t 3000 \
      "Focus" "Focus session of $minutes min started 🍅"
    ;;

  add)
    minutes="${2:-}"
    if ! [[ "$minutes" =~ ^[1-9][0-9]*$ ]] || [ "$minutes" -lt 1 ] || [ "$minutes" -gt 480 ]; then
      echo "Usage: countdown-engine add <1-480>" >&2
      exit 1
    fi
    state_lock
    read_state
    finished_duration=""
    finalize_if_expired || exit 1
    if [ -z "$DURATION" ]; then
      state_unlock
      notify_finished
      notify-send -a countdown -i "dialog-error" -t 4000 \
        "Focus" "No session to add time to."
      exit 1
    fi
    new_duration=$((DURATION + minutes))
    if [ "$new_duration" -gt 480 ]; then
      state_unlock
      notify-send -a countdown -i "dialog-error" -t 4000 \
        "Focus" "Maximum total is 480 min (currently $DURATION min)."
      exit 1
    fi
    remaining=$(get_remaining)
    if [ "$remaining" -le 0 ]; then
      finalize_if_expired || exit 1
      state_unlock
      notify_finished
      exit 1
    fi
    clear_sleep_marker
    DURATION="$new_duration"
    if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ]; then
      END_TIME=$((END_TIME + minutes * 60))
    else
      REMAINING=$((remaining + minutes * 60))
    fi
    write_state || exit 1
    if [ "$RUNNING" = "true" ]; then
      ensure_daemon
    fi
    state_unlock
    notify_waybar
    notify-send -a countdown -i "chronometer" -t 3000 \
      "Focus" "Added $minutes min · session total $DURATION min"
    ;;

  pause|resume|toggle|lock-pause|sleep-pause)
    state_lock
    read_state
    finished_duration=""
    changed=0
    inhibition_cleared=0
    action="$1"
    case "$action" in
      pause|resume|toggle) clear_sleep_marker ;;
    esac
    if [ "$action" = toggle ]; then
      if [ "$RUNNING" = true ]; then action=pause; else action=resume; fi
    fi
    if [ "$action" = resume ]; then
      resume_current || exit 1
    else
      pause_current || exit 1
    fi
    # A confirmed lock ends manual keep-awake mode, including before sleep.
    # Keep this under the same lock as pausing Countdown so neither the daemon
    # nor a concurrent toggle can restore a stale inhibition state.
    case "$action" in
      lock-pause|sleep-pause)
        if [ -f "$MANUAL_FLAG" ]; then
          rm -f -- "$MANUAL_FLAG" || exit 1
          inhibition_cleared=1
          sync_idle_inhibit
        fi
        ;;
    esac
    if [ "$action" = sleep-pause ] && [ -n "$DURATION" ]; then
      touch "$SLEEP_MARKER"
    fi
    state_unlock
    notify_finished
    if [ "$changed" -eq 1 ] || [ "$inhibition_cleared" -eq 1 ]; then
      notify_waybar
    fi
    if [ "$changed" -eq 1 ]; then
      case "$action" in
        resume) notify-send -a countdown -i "chronometer" -t 2000 "Focus" "Resumed ▶" ;;
        pause) notify-send -a countdown -i "chronometer" -t 2000 "Focus" "Paused ⏸" ;;
        lock-pause)
          notify-send -a countdown -i "chronometer" -t 3000 \
            "Focus" "Screen locked — session paused ⏸ (unlock, then press ▶)"
          ;;
      esac
    fi
    ;;

  reset)
    state_lock
    read_state
    finished_duration=""
    finalize_if_expired || exit 1
    maybe_log_current "countdown"
    clear_sleep_marker
    DURATION=""
    INITIAL_DURATION=""
    RUNNING="false"
    END_TIME=""
    REMAINING=""
    TASK=""
    write_state || exit 1
    state_unlock
    notify_finished
    notify_waybar
    ;;

  daemon)
    daemon_loop
    ;;

  status)
    read_state
    finished_duration=""
    # Explicit status requests can also recover a stopped worker. Waybar's
    # render commands below only read snapshots and never start services.
    systemctl --user --quiet is-active countdown-engine.service || ensure_daemon
    if session_expired; then
      state_lock
      read_state
      finalize_if_expired || {
        state_unlock
        exit 1
      }
      state_unlock
    fi
    # Refresh from the latest complete snapshot after any locked transition.
    read_state
    remaining=$(get_remaining)
    if [ -z "$DURATION" ]; then
      text="⏱"
      class="idle"
      tooltip="🍅 Foculocks — no session"
    else
      if [ "$RUNNING" = "true" ]; then
        s_icon="▶"
        s_label="Running"
        class="running"
      else
        s_icon="⏸"
        s_label="Paused"
        class="paused"
      fi
      text="🍅 $(format_time "$remaining") $s_icon"
      tooltip="Focus $DURATION min\\n$s_label · $(format_time "$remaining")"
    fi
    notify_finished
    printf '{"text": "%s", "class": "%s", "tooltip": "%s"}\n' \
      "$text" "$class" "$tooltip"
    ;;

  control-click)
    "$0" status >/dev/null
    read_state
    if [ -z "$DURATION" ]; then
      exec "$HOME/.local/bin/countdown"
    fi
    exec "$0" toggle
    ;;

  status-control)
    read_state
    if [ -z "$DURATION" ]; then
      text=""
      class="idle"
      tooltip="Start a Countdown session"
    elif [ "$RUNNING" = "true" ]; then
      text=""
      class="running"
      tooltip="Pause Countdown"
    else
      text=""
      class="paused"
      tooltip="Resume Countdown"
    fi
    printf '{"text": "%s", "class": "%s", "tooltip": "%s"}\n' \
      "$text" "$class" "$tooltip"
    ;;

  status-time)
    # The worker handles expiry; rendering must not spawn status/service checks
    # on every clock tick, or restart a deliberately stopped worker.
    read_state
    remaining=$(get_remaining)
    if [ -z "$DURATION" ]; then
      text=""
      class="idle"
      tooltip=""
    elif [ "$RUNNING" = "true" ]; then
      text="$(format_time "$remaining")"
      class="running"
      tooltip="Running · $(format_time "$remaining") remaining"
    else
      text="$(format_time "$remaining")"
      class="paused"
      tooltip="Paused · $(format_time "$remaining") remaining"
    fi
    if [ -n "$TASK" ]; then
      task_display="${TASK:0:20}"
      if [ "${#TASK}" -gt 20 ]; then
        task_display+="…"
      fi
      text+=" · $task_display"
      tooltip="Task: $TASK"$'\n'"$tooltip"
    fi
    if [ -n "$INITIAL_DURATION" ]; then
      text+=" (${INITIAL_DURATION}m)"
      tooltip+=$'\n'"Estimate: ${INITIAL_DURATION} min"
    fi
    # shellcheck disable=SC2016
    "$JQ" -cn --arg text "$text" --arg class "$class" --arg tooltip "$tooltip" \
      '{text: $text, class: $class, tooltip: $tooltip}'
    ;;

  idle-allowed)
    # Read-only diagnostic; the session manager does not call into Countdown.
    read_state
    if idle_inhibited; then exit 1; fi
    ;;

  inhibit-state)
    # Fast read-only snapshot for menus; state transitions stay in countdown-engine commands.
    read_state
    printf -v now '%(%s)T' -1
    manual_json=false
    [ -f "$MANUAL_FLAG" ] && manual_json=true
    if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ] && [ "$END_TIME" -gt "$now" ]; then
      inhibit_class="running"
    elif [ "$manual_json" = true ]; then
      inhibit_class="manual"
    else
      inhibit_class="idle"
    fi
    printf '%s %s\n' "$inhibit_class" "$manual_json"
    ;;

  inhibit)
    # JSON state for Waybar and options.
    read_state
    manual_json=false
    [ -f "$MANUAL_FLAG" ] && manual_json=true
    if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ]; then
      printf '{"text": "%s", "class": "%s", "tooltip": "%s", "manual": %s}\n' \
        "$(printf '\xef\x81\xae')" "running" \
        "Focus is active — idle is inhibited automatically\\nClick has no effect while Countdown is running" "$manual_json"
    elif [ -f "$MANUAL_FLAG" ]; then
      printf '{"text": "%s", "class": "%s", "tooltip": "%s", "manual": true}\n' \
        "$(printf '\xef\x81\xae')" "manual" \
        "Manual idle inhibition is ON\\nClick to turn it off"
    else
      printf '{"text": "%s", "class": "%s", "tooltip": "%s", "manual": false}\n' \
        "$(printf '\xef\x81\xb0')" "idle" \
        "Idle inhibition is OFF\\nClick to turn it on or start a Focus session"
    fi
    ;;

  inhibit-toggle)
    # Ignore clicks during Countdown; do not save them as a later manual toggle.
    "$0" status >/dev/null 2>&1
    state_lock
    read_state
    if [ "$RUNNING" = "true" ] && [ -n "$END_TIME" ] && [ "$END_TIME" -gt "$(date +%s)" ]; then
      sync_idle_inhibit
      state_unlock
      exit 0
    fi
    if [ -f "$MANUAL_FLAG" ]; then
      rm -f "$MANUAL_FLAG"
      toggle_msg="Off"
    else
      : > "$MANUAL_FLAG"
      toggle_msg="On"
    fi
    sync_idle_inhibit
    state_unlock
    notify_waybar
    if [ "$RUNNING" = "true" ] && [ "$toggle_msg" = "Off" ]; then
      notify-send -a countdown -i "dialog-information" -t 3000 \
        "Idle inhibition" "Focus is active — automatic inhibition stays on until the session ends"
    else
      notify-send -a countdown -i "dialog-information" -t 2000 \
        "Idle inhibition" "$toggle_msg — screen locking, display sleep, and suspend behavior updated"
    fi
    ;;

  sleep-resume)
    # Machine woke: do NOT auto-resume — the session STAYS paused, the user
    # presses ▶ to continue (same after unlocking). Remaining behavior:
    # expired during sleep -> finalize; no marker -> just sync anti-idle.
    state_lock
    read_state
    woken_paused=0
    finished_duration=""
    finalize_if_expired || exit 1
    if [ -f "$SLEEP_MARKER" ]; then
      rm -f "$SLEEP_MARKER" 2>/dev/null || true
      if [ "$RUNNING" != "true" ] && [ -n "$REMAINING" ] && [ "$REMAINING" -gt 0 ]; then
        # REMAINING was preserved by sleep-pause -> keep it, just notify.
        woken_paused=1
      fi
    fi
    sync_idle_inhibit
    state_unlock
    notify_finished
    if [ "$woken_paused" -eq 1 ]; then
      notify-send -a countdown -i "chronometer" -t 5000 \
        "Focus" "Just woke up — unlock, session is PAUSED ⏸ (press ▶ to continue)"
    fi
    notify_waybar
    ;;

  *)
    echo "Usage: countdown-engine {start <1-480>|add <1-480>|pause|resume|toggle|reset|status|inhibit|inhibit-state|inhibit-toggle|idle-allowed|lock-pause|sleep-pause|sleep-resume|daemon}" >&2
    exit 1
    ;;
esac

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/swayidle -w \
  timeout 10 '/usr/bin/swaymsg "output * power off"' \
  resume '/usr/bin/swaymsg "output * power on"'

ExecStopPost=-/usr/bin/swaymsg 'output * power on'
Restart=on-failure
RestartSec=2

[Unit]
After=swaylock.service
BindsTo=swaylock.service
Description=Turn off locked displays after a short idle period
PartOf=swaylock.service

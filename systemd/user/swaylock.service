[Service]
# Wait for the compositor's locked event while keeping swaylock as the main PID.
ExecStart=/bin/bash -c 'exec /usr/bin/swaylock -e --image "%h/.local/share/wallpapers/lock.png" --ready-fd 3 3> >(read -r && exec /usr/bin/systemd-notify --ready)'
ExecStopPost=-%h/.local/bin/countdown-engine unlock-notify
NotifyAccess=all
Type=notify

[Unit]
After=sway-session.target
Description=Sway screen lock
PartOf=sway-session.target
Wants=locked-display.service
Wants=session-locked.target

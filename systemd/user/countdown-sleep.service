[Install]
WantedBy=sway-session.target

[Service]
ExecStart=/usr/bin/swayidle -w \
  before-sleep '/usr/bin/timeout --kill-after=1s 2s %h/.local/bin/countdown-engine sleep-pause' \
  after-resume '/usr/bin/timeout --kill-after=1s 2s %h/.local/bin/countdown-engine sleep-resume'

Restart=always
RestartSec=2

[Unit]
After=sway-session.target
Description=Pause Countdown before sleep and preserve it on wake
PartOf=sway-session.target

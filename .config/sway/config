# Session lifetime is owned by dotfiles-sway.
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu tofi-drun

# Applets & daemons
# Restore the selected night light mode.
exec ~/.local/bin/session-start

input type:touchpad {
  pointer_accel 0.6
  accel_profile adaptive
  natural_scroll enabled
  scroll_method two_finger
  tap enabled
  drag enabled
  dwt enabled
}
# Keep the physical layout explicit; Fcitx handles Vietnamese input separately.
input type:keyboard {
  xkb_layout us
}
seat * hide_cursor 10000
seat * xcursor_theme Bibata-Modern-Classic 24

# Gruvbox Material styling
gaps inner 5
gaps outer 3
gaps bottom 0
default_border pixel 2
default_floating_border pixel 2
# Give tabbed/stacking titles room without adding titlebars to tiled windows.
font pango:JetBrains Mono 10
titlebar_padding 10 5
title_align left
# $mod + left/right mouse button = move/resize floating windows.
floating_modifier $mod normal
focus_follows_mouse yes
# Applies to all apps: focus eligible activation requests, not urgency alone.
focus_on_window_activation focus
smart_borders off

# Brighter selected tabs; inactive groups retain a quieter selection.
# Muted beige focus border; soft ochre indicates the next split.
client.focused           #a89984 #3c3836 #ddc7a1 #c5a87c #a89984
client.focused_inactive  #45403d #32302f #d4be98 #45403d #45403d
client.unfocused         #3c3836 #282828 #a89984 #3c3836 #3c3836
client.urgent            #e78a4e #282828 #e78a4e #45403d #e78a4e
client.placeholder       #282828 #282828 #d4be98 #45403d #45403d
client.background        #282828

# Floating rules
# Give the full HH:MM:SS timer room to render.
for_window [app_id="^countdown$"] floating enable, resize set width 520 px height 200 px, move scratchpad, scratchpad show, mark --add popup-countdown
# Keep the popup terminal at Foot's default size, as before.
for_window [app_id="scratchpad-terminal"] move scratchpad, scratchpad show, mark --add popup-terminal
# Native scratchpad toggles; the helper launches an absent application.
for_window [app_id="(?i)^(md\.obsidian\.)?obsidian$"] floating enable, move scratchpad, scratchpad show, move position center, mark --add popup-obsidian
for_window [class="(?i)^(md\.obsidian\.)?obsidian$"] floating enable, move scratchpad, scratchpad show, move position center, mark --add popup-obsidian
# TickTick opens floating; Mod+i toggles it without quitting the app.
for_window [app_id="(?i)^(com\.ticktick\.)?ticktick$"] floating enable, move scratchpad, scratchpad show, resize set width 60 ppt height 75 ppt, move position center, mark --add popup-ticktick
for_window [class="(?i)^(com\.ticktick\.)?ticktick$"] floating enable, move scratchpad, scratchpad show, resize set width 60 ppt height 75 ppt, move position center, mark --add popup-ticktick
# WireMix runs inside Foot; keep the audio mixer in a compact floating window.
for_window [app_id="wiremix"] floating enable, resize set width 50 ppt height 60 ppt
for_window [app_id="bluetui"] floating enable, resize set 750 px 500 px
for_window [app_id="impala"] floating enable, resize set width 60 ppt height 65 ppt
for_window [title="htop"] floating enable, resize set width 50 ppt height 70 ppt

# GoldenDict joins the native scratchpad for Mod+g.
for_window [app_id="io.github.xiaoyifang.goldendict_ng"] floating enable, move scratchpad, scratchpad show, resize set width 50 ppt height 65 ppt, mark --add popup-dictionary
# Sioyek: new windows open on the focused workspace.
for_window [app_id="(?i)^sioyek$"] move container to workspace current

# Move Anki to workspace 10 and switch there when it opens.
for_window [app_id="(?i)^anki$"] move container to workspace number 10, workspace number 10, focus
for_window [class="(?i)^anki$"] move container to workspace number 10, workspace number 10, focus

# Open Foliate on the currently focused workspace.
for_window [app_id="(?i)^com\.github\.johnfactotum\.foliate$"] move container to workspace current

# Thunar popup; Mod+Shift+Space toggles it back to tiling.
for_window [app_id="(?i)^thunar$"] floating enable, resize set width 40 ppt height 65 ppt

# Dialog/popup rules
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_role="About"] floating enable
for_window [title="Save File"] floating enable

# Center file choosers opened by xdg-desktop-portal-gtk.
for_window [app_id="(?i)^xdg-desktop-portal-gtk$"] floating enable, move position center

# Chrome Picture-in-Picture
for_window [title="Picture in picture"] floating enable, sticky enable, resize set width 350 px height 197 px, move position 1530 px 800 px

# Inhibit idle
for_window [app_id="(?i)^google-chrome$"] inhibit_idle fullscreen

# Keybindings - App & Session
bindsym $mod+Return exec $term
bindsym --no-repeat $mod+grave exec ~/.local/bin/scratchpad-terminal
bindsym --no-repeat $mod+o exec ~/.local/bin/obsidian-toggle
bindsym --no-repeat $mod+i exec ~/.local/bin/ticktick-toggle
bindsym --no-repeat $mod+d exec $menu
# Return to the workspace just left; repeat to toggle between the two.
bindsym --no-repeat Mod1+Tab workspace back_and_forth
# Mod+u opens utilities; Mod+p opens power actions.
# Mod+c opens Countdown.
# Toggle Sway's native scratchpad; Shift+Mod+- sends the focused window there.
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad
# Select a hidden scratchpad window, or show all hidden windows here.
bindsym --no-repeat $mod+equal exec ~/.local/bin/scratchpad-menu
bindsym --no-repeat $mod+Shift+equal exec ~/.local/bin/scratchpad-menu --show-all
# Mod+Tab opens the Sway workspace overview.
bindsym $mod+Tab exec pkill -x swayview || swayview
bindsym $mod+q kill

bindsym $mod+Shift+c exec ~/.local/bin/refresh-session
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+c exec ~/.local/bin/countdown
# Focus movement
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Container movement
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Ten numbered workspaces; the 0 key selects workspace 10.
# Numeric identities match Sway's initial workspace and Waybar's pins/icons.
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+0 move container to workspace number 10
# Cycle through workspaces; Shift moves the focused window.
bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next
bindsym $mod+Shift+bracketleft move container to workspace prev
bindsym $mod+Shift+bracketright move container to workspace next
# Layout & Window State
# Native layouts also support split groups inside floating popups.
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child
# Enter Sway's native resize mode.
bindsym $mod+r mode "resize"

mode "resize" {
  bindsym $left resize shrink width 10 px or 10 ppt
  bindsym $down resize grow height 10 px or 10 ppt
  bindsym $up resize shrink height 10 px or 10 ppt
  bindsym $right resize grow width 10 px or 10 ppt
  bindsym Left resize shrink width 10 px or 10 ppt
  bindsym Down resize grow height 10 px or 10 ppt
  bindsym Up resize shrink height 10 px or 10 ppt
  bindsym Right resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}

# Custom Utilities & Screenshot
# Toggle Waybar visibility (SIGUSR1 toggles it by default).
bindsym $mod+Shift+b exec systemctl --user kill --signal=SIGUSR1 --kill-whom=main waybar.service
# Mod+u opens daily utilities; Mod+p opens session and power actions.
bindsym $mod+u exec ~/.local/bin/utilities
bindsym $mod+p exec ~/.local/bin/utilities --power
bindsym $mod+Escape exec ~/.local/bin/lock-screen
# Quick language tools: Mod+t translates Vietnamese to English; Shift reverses it;
# Ctrl+t fixes English. Optional context prefixes: [phi], [sci], [lit], [cas].
bindsym $mod+t exec ~/.local/bin/quick-lang vi-en
bindsym $mod+Shift+t exec ~/.local/bin/quick-lang en-vi
bindsym $mod+Ctrl+t exec ~/.local/bin/quick-lang fix
# Toggle the GoldenDict scratchpad window.
bindsym --no-repeat $mod+g exec ~/.local/bin/dict-toggle
bindsym $mod+Mod1+t exec ~/.local/bin/toggle-touchpad
bindsym $mod+Print exec ~/.local/bin/screenshot-menu
bindsym --no-repeat Print exec ~/.local/bin/screenshot selection-clipboard
bindsym --no-repeat Mod1+Print exec ~/.local/bin/screenshot fullscreen-clipboard
bindsym --no-repeat Shift+Print exec ~/.local/bin/screenshot selection-save
bindsym --no-repeat Ctrl+Print exec ~/.local/bin/screenshot fullscreen-save

# Media & Brightness keys
bindsym XF86AudioRaiseVolume exec ~/.local/bin/media-notify volume-up
bindsym XF86AudioLowerVolume exec ~/.local/bin/media-notify volume-down
bindsym --no-repeat XF86AudioMute exec ~/.local/bin/media-notify volume-mute
bindsym --no-repeat XF86AudioMicMute exec ~/.local/bin/media-notify mic-mute
bindsym --no-repeat XF86AudioPlay exec playerctl play-pause
bindsym --no-repeat XF86AudioPause exec playerctl pause
bindsym --no-repeat XF86AudioStop exec playerctl stop
bindsym --no-repeat XF86AudioNext exec playerctl next
bindsym --no-repeat XF86AudioPrev exec playerctl previous
bindsym XF86MonBrightnessUp exec ~/.local/bin/media-notify brightness-up
bindsym XF86MonBrightnessDown exec ~/.local/bin/media-notify brightness-down

# Lock, display power and idle suspend are managed in ../session.
